APP_HOST=0.0.0.0
APP_PORT=8000
# Адрес для запуска утилит и API вне Docker; в compose используется qdrant.
APP_QDRANT_URL=http://localhost:6333
APP_CATALOG_PATH=data/embedings/wine_catalog.json
APP_LINKS_PATH=data/embedings/wine_links.json
APP_IMAGES_PATH=data/images
APP_YOLO_MODEL_PATH=data/yolo_ann/runs/bottle_yolo26n/weights/best.pt
# true — принудительно переимпортировать JSON в PostgreSQL при старте контейнера
APP_CATALOG_REIMPORT=false
# Для запуска API вне Docker:
# APP_DATABASE_URL=postgresql+psycopg://wine:wine_password@localhost:5432/vino_svoe
APP_EMBEDDING_DEVICE=auto
APP_YOLO_DEVICE=auto
APP_OCR_DEVICE=auto
APP_OCR_ENABLED=true
APP_MAX_UPLOAD_SIZE_BYTES=10485760
APP_SIGLIP_REVISION=1b426889ea62b5a72bf9839009a1b184bfc9c178
APP_TEXT_MODEL_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
APP_RETRIEVAL_VISUAL_SCORE_THRESHOLD=0.70
APP_RETRIEVAL_VISUAL_STRONG_SCORE_THRESHOLD=0.75
APP_RETRIEVAL_VISUAL_MARGIN_THRESHOLD=0.005
APP_RETRIEVAL_OCR_VISUAL_SCORE_THRESHOLD=0.60

# GPU wheels для production Docker-образа. Torch и torchvision должны быть
# парой одной версии CUDA; значения ниже не привязаны к RTX 3050.
PYTORCH_VERSION=2.8.0+cu126
TORCHVISION_VERSION=0.23.0+cu126
PADDLE_VERSION=3.3.0

# Параметры PostgreSQL для docker-compose.
DB_USER=wine
DB_PASSWORD=wine_password
DB_NAME=vino_svoe
DB_PORT=5432
